<UserControl x:Class="Energy.Controls.HeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="1920"
             d:DesignWidth="260">

    <Grid Background="{DynamicResource MenuBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- LOGO -->

        <StackPanel Grid.Row="0"
                    Margin="24,30,24,20">

            <TextBlock Text="ENERGY"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <TextBlock Text="fitness club"
                       Margin="0,4,0,0"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>

        </StackPanel>

        <!-- MENU -->

        <StackPanel Grid.Row="1">

            <Button x:Name="btn_Groupe"
                    Style="{StaticResource SidebarButton}"
                    Content="Групповые занятия"
                    Click="btn_Groupe_Click"/>

            <Button x:Name="btn_Trainers"
                    Style="{StaticResource SidebarButton}"
                    Content="Тренерский состав"
                    Click="btn_Trainers_Click"/>

            <Button x:Name="btn_Subscriptions"
                    Style="{StaticResource SidebarButton}"
                    Content="Абонементы"
                    Click="btn_Subscriptions_Click"/>

        </StackPanel>

        <!-- BOTTOM -->

        <StackPanel Grid.Row="2"
                    Margin="0,10,0,24">

            <Border Height="1"
                    Margin="20,0,20,16"
                    Background="{DynamicResource BorderBrush}"/>

            <Button x:Name="btn_Profile"
                    Style="{StaticResource SidebarButton}"
                    Content="Профиль"
                    Click="btn_Profile_Click"/>

            <Button x:Name="btn_Logout"
                    Style="{StaticResource SidebarButton}"
                    Content="Выйти"
                    Click="btn_Logout_Click"/>

        </StackPanel>

    </Grid>
</UserControl>