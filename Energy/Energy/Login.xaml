<Window x:Class="Energy.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Energy"
        mc:Ignorable="d"
        Title="Login" Height="600" Width="1000" Background="#ffdadada">
    <Grid>
        <Border MinWidth="400" Margin="30" Background="White"
                VerticalAlignment="Center" Padding="30" MaxWidth="600">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="LightGray" ShadowDepth="5"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Вход" FontSize="30" FontWeight="SemiBold" Margin="0 0 0 20"/>

                <Grid Margin="0 0 0 20">
                    <Button Background="Transparent" BorderBrush="Transparent"
                            HorizontalAlignment="Left" Content="Зарегистрироваться" 
                            Click="SwitchToRegistration_Click"></Button>
                </Grid>

                <Grid Margin="0 0 0 10">
                    <TextBox x:Name="txtBoxLogin" Padding="10,8" FontSize="14"/>
                    <TextBlock Text="Логин" IsHitTestVisible="False" 
                    Margin="12,0,0,0" VerticalAlignment="Center"
                    Foreground="Gray" FontSize="14" 
                    Cursor="IBeam">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtBoxLogin}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Grid Margin="0 0 0 10">
                    <PasswordBox x:Name="txtBoxPassword" Padding="10,8" FontSize="14"
                                 PasswordChanged="txtBoxPassword_PasswordChanged"/>
                    <TextBlock x:Name="txtPasswordHint" Text="Пароль" IsHitTestVisible="False" 
                               Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="Gray" FontSize="14" Cursor="IBeam">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button Margin="0 20" Padding="0 5" Content="Войти" 
                        Click="Button_Login_Click"></Button>

            </StackPanel>
        </Border>
    </Grid>
</Window>
