<Window x:Class="Energy.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Energy"
        mc:Ignorable="d"
        Title="Login"
        Height="700"
        Width="1200"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="540" />
        </Grid.ColumnDefinitions>

        <!-- LEFT -->
        <Grid>
            <StackPanel VerticalAlignment="Center"
                        Margin="80">
                <TextBlock Text="ENERGY"
                           FontSize="48"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Добро пожаловать обратно"
                           Margin="0,14,0,0"
                           FontSize="18"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

            </StackPanel>
        </Grid>

        <!-- RIGHT -->
        <Border Grid.Column="1"
                Margin="40"
                Padding="50"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="28"
                VerticalAlignment="Center"
                MaxWidth="500">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                                  ShadowDepth="0"
                                  Opacity="0.12"/>
            </Border.Effect>

            <StackPanel>

                <TextBlock Text="Вход"
                           FontSize="34"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Введите данные аккаунта"
                           FontSize="14"
                           Margin="0,0,0,30"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                <!-- LOGIN -->
                <TextBlock Text="Логин"
                           Margin="0,0,0,6"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBox x:Name="txtBoxLogin"
                         Margin="0,0,0,18"/>

                <!-- PASSWORD -->
                <Grid Margin="0,0,0,14">
                    <PasswordBox x:Name="txtBoxPassword"
                 PasswordChanged="txtBoxPassword_PasswordChanged"/>
                    <TextBlock x:Name="txtPasswordHint"
               Text="Пароль"
               IsHitTestVisible="False"
               Margin="12,0,0,0"
               VerticalAlignment="Center"
               Foreground="{DynamicResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility"
                        Value="Visible"/>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- REMEMBER -->
                <CheckBox x:Name="RememberMeCheckBox"
                          Content="Запомнить меня"
                          Margin="0,0,0,28"
                          FontSize="14"
                          IsChecked="True"/>

                <!-- BUTTON -->
                <Button Content="Войти"
                        Height="48"
                        FontSize="15"
                        Background="{DynamicResource ButtonPrimaryBrush}"
                        Click="Button_Login_Click"/>

                <!-- SWITCH -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,24,0,0">
                    <TextBlock Text="Нет аккаунта?"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button Content="Регистрация"
                            Margin="10,0,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource AccentBrush}"
                            Cursor="Hand"
                            Click="SwitchToRegistration_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>