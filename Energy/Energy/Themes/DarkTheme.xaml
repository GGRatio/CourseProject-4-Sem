<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Меню -->
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#1A1A2E"/>
    <SolidColorBrush x:Key="MenuButtonBackgroundBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="MenuButtonHoverBrush" Color="#16213E"/>
    <SolidColorBrush x:Key="MenuButtonForegroundBrush" Color="#FFFFFF"/>

    <!-- Фоны -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2D2D2D"/>

    <!-- Текст -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AAAAAA"/>

    <!-- Границы -->
    <SolidColorBrush x:Key="BorderBrush" Color="#444444"/>

    <!-- Кнопка фильтра -->
    <SolidColorBrush x:Key="FilterButtonBrush" Color="#444444"/>
    <SolidColorBrush x:Key="FilterButtonHoverBrush" Color="#555555"/>

    <!-- Кнопка основная (синяя) -->
    <SolidColorBrush x:Key="ButtonPrimaryBrush" Color="#1976D2"/>
    <SolidColorBrush x:Key="ButtonPrimaryHoverBrush" Color="#1565C0"/>

    <!-- Кнопка успеха (зелёная) -->
    <SolidColorBrush x:Key="ButtonSuccessBrush" Color="#388E3C"/>
    <SolidColorBrush x:Key="ButtonSuccessHoverBrush" Color="#2E7D32"/>
    <SolidColorBrush x:Key="ButtonSuccessPressedBrush" Color="#1B5E20"/>

    </ResourceDictionary>