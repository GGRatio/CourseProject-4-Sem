<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Меню -->
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#758a87"/>
    <SolidColorBrush x:Key="MenuButtonBackgroundBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="MenuButtonHoverBrush" Color="#5e6f6c"/>
    <SolidColorBrush x:Key="MenuButtonForegroundBrush" Color="White"/>


    <!-- Фоны -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>

    <!-- Текст -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#333333"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#888888"/>

    <!-- Границы -->
    <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0"/>

    <!-- Кнопка фильтра -->
    <SolidColorBrush x:Key="FilterButtonBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="FilterButtonHoverBrush" Color="#CCCCCC"/>

    <!-- Кнопка основная (синяя) -->
    <SolidColorBrush x:Key="ButtonPrimaryBrush" Color="#2196F3"/>
    <SolidColorBrush x:Key="ButtonPrimaryHoverBrush" Color="#1976D2"/>

    <!-- Кнопка успеха (зелёная) -->
    <SolidColorBrush x:Key="ButtonSuccessBrush" Color="#4CAF50"/>
    <SolidColorBrush x:Key="ButtonSuccessHoverBrush" Color="#45A049"/>
    <SolidColorBrush x:Key="ButtonSuccessPressedBrush" Color="#2E7D32"/>

</ResourceDictionary>