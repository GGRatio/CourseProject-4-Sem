<Window x:Class="Energy.Registration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Energy"
        mc:Ignorable="d"
        Title="Registration"
        Height="700"
        Width="1200"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="540" />
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDE -->
        <Grid>
            <StackPanel VerticalAlignment="Center"
                        Margin="80">
                <TextBlock Text="ENERGY"
                           FontSize="48"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Фитнес система нового поколения"
                           Margin="0,14,0,0"
                           FontSize="18"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- RIGHT SIDE -->
        <Border Grid.Column="1"
                Margin="40"
                Padding="50"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="28"
                VerticalAlignment="Center"
                MaxWidth="500">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                                  ShadowDepth="0"
                                  Opacity="0.12"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Регистрация"
                           FontSize="34"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Создайте аккаунт для продолжения"
                           FontSize="14"
                           Margin="0,0,0,30"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                <!-- LOGIN -->
                <TextBlock Text="Логин"
                           Margin="0,0,0,6"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBox x:Name="txtBoxLogin"
                         Margin="0,0,0,18"/>

                <Grid Margin="0,0,0,18">
                    <PasswordBox x:Name="txtBoxPassword"
                 PasswordChanged="txtBoxPassword_PasswordChanged"/>
                    <TextBlock x:Name="txtPasswordHint"
               Text="Пароль"
               IsHitTestVisible="False"
               Margin="12,0,0,0"
               VerticalAlignment="Center"
               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Grid>

                <Grid Margin="0,0,0,18">
                    <PasswordBox x:Name="txtBoxPassword2"
                 PasswordChanged="txtBoxPassword2_PasswordChanged"/>
                    <TextBlock x:Name="txtPasswordHint2"
               Text="Повторите пароль"
               IsHitTestVisible="False"
               Margin="12,0,0,0"
               VerticalAlignment="Center"
               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Grid>

                <!-- EMAIL -->
                <TextBlock Text="Email"
                           Margin="0,0,0,6"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBox x:Name="txtBoxEmail"
                         Margin="0,0,0,30"/>

                <!-- BUTTON -->
                <Button Content="Зарегистрироваться"
                        Height="48"
                        FontSize="15"
                        Background="{DynamicResource ButtonPrimaryBrush}"
                        Click="Button_Reg_Click"/>

                <!-- SWITCH -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,24,0,0">
                    <TextBlock Text="Уже есть аккаунт?"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button Content="Войти"
                            Margin="10,0,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource AccentBrush}"
                            Cursor="Hand"
                            Click="SwitchToLogin_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>