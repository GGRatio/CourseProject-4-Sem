<Page x:Class="Energy.Pages.TrainerProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Профиль тренера"
      Background="{DynamicResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Width="700"
                    Margin="30"
                    HorizontalAlignment="Center">

            <Border Width="140"
                    Height="140"
                    CornerRadius="70"
                    Background="{DynamicResource BorderBrush}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20">

                <Image x:Name="imgPhoto"
                       Stretch="UniformToFill"/>

            </Border>

            <TextBlock x:Name="txtName"
                       FontSize="30"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <TextBlock x:Name="txtSpecialization"
                       Margin="0,8,0,24"
                       FontSize="15"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>

            <Border Style="{StaticResource SectionCard}">

                <StackPanel>

                    <TextBlock Text="Опыт"
                               Style="{StaticResource SectionTitle}"/>

                    <TextBlock x:Name="txtExperience"
                               TextWrapping="Wrap"/>

                </StackPanel>

            </Border>

            <Border Style="{StaticResource SectionCard}">

                <StackPanel>

                    <TextBlock Text="О себе"
                               Style="{StaticResource SectionTitle}"/>

                    <TextBlock x:Name="txtDescription"
                               TextWrapping="Wrap"/>

                </StackPanel>

            </Border>

            <Border Style="{StaticResource SectionCard}">

                <StackPanel>

                    <TextBlock Text="Оставить отзыв"
                               Style="{StaticResource SectionTitle}"/>

                    <TextBox x:Name="txtComment"
                             Height="90"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,14"/>

                    <Button Content="Отправить отзыв"
                            Width="170"
                            Style="{StaticResource SuccessButton}"
                            Click="SendReview_Click"/>

                </StackPanel>

            </Border>

            <Border Style="{StaticResource SectionCard}">

                <StackPanel>

                    <TextBlock Text="Отзывы клиентов"
                               Style="{StaticResource SectionTitle}"/>

                    <ListBox x:Name="lstReviews"
                             BorderThickness="0"
                             Background="Transparent"
                             MaxHeight="320">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border Background="{DynamicResource BackgroundBrush}"
                                        CornerRadius="10"
                                        Padding="12"
                                        Margin="0,0,0,10">

                                    <StackPanel>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,0,0,6">

                                            <TextBlock Text="{Binding UserName}"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock Text=" · "
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>

                                            <TextBlock Text="{Binding CreatedAt, StringFormat='dd.MM.yyyy'}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>

                                        </StackPanel>

                                        <TextBlock Text="{Binding Comment}"
                                                   TextWrapping="Wrap"/>

                                    </StackPanel>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                </StackPanel>

            </Border>

            <Button Content="Назад к тренерам"
                    Width="190"
                    Margin="0,10,0,20"
                    Style="{StaticResource PrimaryButton}"
                    Click="Back_Click"/>

        </StackPanel>

    </ScrollViewer>

</Page>