<Page x:Class="Energy.Pages.SubscriptionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Energy.Pages"
      xmlns:controls="clr-namespace:Energy.Controls"
      mc:Ignorable="d"
      Title="Абонементы"
      Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Style="{StaticResource FilterPanel}">

            <Button x:Name="btnAll"
                    Content="Все"
                    Style="{StaticResource FilterButtonActive}"
                    Click="Filter_Click"
                    Tag="all"/>

            <Button x:Name="btnStudent"
                    Content="Студентам"
                    Style="{StaticResource FilterButton}"
                    Click="Filter_Click"
                    Tag="student"/>

            <Button x:Name="btnDayTime"
                    Content="До 16:00"
                    Style="{StaticResource FilterButton}"
                    Click="Filter_Click"
                    Tag="daytime"/>

            <Button x:Name="btnUnlimited"
                    Content="Безлимит"
                    Style="{StaticResource FilterButton}"
                    Click="Filter_Click"
                    Tag="unlimited"/>

            <Button x:Name="btnMonthly"
                    Content="На месяц"
                    Style="{StaticResource FilterButton}"
                    Click="Filter_Click"
                    Tag="monthly"/>

        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <UniformGrid x:Name="SubscriptionsPanel"
                         Columns="3"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top"/>

        </ScrollViewer>

    </Grid>

</Page>