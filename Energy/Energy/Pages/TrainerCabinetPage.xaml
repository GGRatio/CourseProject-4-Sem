<Page x:Class="Energy.Pages.TrainerCabinetPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Кабинет тренера"
      Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtTitle"
                   Style="{StaticResource PageTitle}"
                   Margin="0,0,0,24"/>

        <TabControl Grid.Row="1">

            <TabItem Header="Будущие занятия">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <ItemsControl x:Name="futureClassesList"
                                  Margin="4">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Border Style="{StaticResource SimpleCard}">

                                    <StackPanel>

                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource CardTitleSmall}"/>

                                        <TextBlock Text="{Binding ClassDate, StringFormat='dd.MM.yyyy HH:mm'}"
                                                   Margin="0,8,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                                        <TextBlock Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}">

                                            <Run Text="Участников: "/>
                                            <Run Text="{Binding CurrentParticipants}"/>
                                            <Run Text="/"/>
                                            <Run Text="{Binding MaxParticipants}"/>

                                        </TextBlock>

                                    </StackPanel>

                                </Border>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </ScrollViewer>

            </TabItem>

            <TabItem Header="Посещаемость">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <ItemsControl x:Name="pastClassesList"
                                  Margin="4">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Border Style="{StaticResource SimpleCard}">

                                    <StackPanel>

                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource CardTitleSmall}"/>

                                        <TextBlock Text="{Binding ClassDate, StringFormat='dd.MM.yyyy HH:mm'}"
                                                   Margin="0,8,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                                        <TextBlock Margin="0,4,0,10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}">

                                            <Run Text="Участников: "/>
                                            <Run Text="{Binding CurrentParticipants}"/>
                                            <Run Text="/"/>
                                            <Run Text="{Binding MaxParticipants}"/>

                                        </TextBlock>

                                        <Button Content="Отметить посещаемость"
                                                Width="220"
                                                Style="{StaticResource SuccessButton}"
                                                Click="MarkAttendance_Click"
                                                Tag="{Binding Id}"/>

                                    </StackPanel>

                                </Border>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </ScrollViewer>

            </TabItem>

            <TabItem Header="Мои клиенты">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <ItemsControl x:Name="clientsList"
                                  Margin="4">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Border Style="{StaticResource SimpleCard}">

                                    <StackPanel>

                                        <TextBlock Style="{StaticResource CardTitleSmall}">

                                            <Run Text="{Binding FirstName}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding LastName}"/>

                                        </TextBlock>

                                        <TextBlock Text="{Binding Email}"
                                                   Margin="0,8,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                                        <TextBlock Text="{Binding Phone}"
                                                   Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Page>