<Page x:Class="Energy.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Админ панель"
      Background="White">

    <StackPanel Margin="50" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="👑 Админ панель" FontSize="32" FontWeight="Bold" Margin="0,0,0,30"/>

        <Button Content="📋 Управление абонементами" Click="ManageSubscriptions_Click" 
                Width="300" Height="50" Margin="0,10" Background="#4CAF50" Foreground="White" FontSize="16"/>

        <Button Content="👥 Пользователи" Click="ManageUsers_Click" 
                Width="300" Height="50" Margin="0,10" Background="#2196F3" Foreground="White" FontSize="16"/>

        <Button Content="📊 Статистика" Click="Statistics_Click" 
                Width="300" Height="50" Margin="0,10" Background="#FF9800" Foreground="White" FontSize="16"/>
    </StackPanel>
</Page>