<Page x:Class="Energy.Pages.AdminPages.AdminUsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Управление пользователями"
      Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <TextBlock Text="Управление пользователями"
                   Style="{DynamicResource PageTitle}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- FORM -->

        <Border Grid.Row="1"
                Style="{DynamicResource SectionCard}">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- LOGIN -->

                <TextBlock Text="Логин:"
                           Grid.Row="0"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="txtLogin"
                         Grid.Row="0"
                         Grid.Column="1"
                         Margin="0,0,20,0"/>

                <!-- EMAIL -->

                <TextBlock Text="Email:"
                           Grid.Row="0"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="txtEmail"
                         Grid.Row="0"
                         Grid.Column="3"/>

                <!-- PASSWORD -->

                <TextBlock Text="Пароль:"
                           Grid.Row="1"
                           Grid.Column="0"
                           Margin="0,15,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <PasswordBox x:Name="txtPassword"
                             Grid.Row="1"
                             Grid.Column="1"
                             Margin="0,15,20,0"/>

                <!-- FIRSTNAME -->

                <TextBlock Text="Имя:"
                           Grid.Row="2"
                           Grid.Column="0"
                           Margin="0,15,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="txtFirstName"
                         Grid.Row="2"
                         Grid.Column="1"
                         Margin="0,15,20,0"/>

                <!-- LASTNAME -->

                <TextBlock Text="Фамилия:"
                           Grid.Row="2"
                           Grid.Column="2"
                           Margin="0,15,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="txtLastName"
                         Grid.Row="2"
                         Grid.Column="3"
                         Margin="0,15,0,0"/>

                <!-- PHONE -->

                <TextBlock Text="Телефон:"
                           Grid.Row="3"
                           Grid.Column="0"
                           Margin="0,15,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="txtPhone"
                         Grid.Row="3"
                         Grid.Column="1"
                         Margin="0,15,20,0"/>

                <!-- ROLE -->

                <TextBlock Text="Роль:"
                           Grid.Row="3"
                           Grid.Column="2"
                           Margin="0,15,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <ComboBox x:Name="cbRole"
                          Grid.Row="3"
                          Grid.Column="3"
                          Margin="0,15,0,0">

                    <ComboBoxItem Content="User"/>
                    <ComboBoxItem Content="Trainer"/>
                    <ComboBoxItem Content="Admin"/>

                </ComboBox>

                <!-- BUTTONS -->

                <WrapPanel Grid.Row="4"
                           Grid.ColumnSpan="4"
                           HorizontalAlignment="Center"
                           Margin="0,25,0,0">

                    <Button Content="➕ Добавить"
                            Click="Add_Click"
                            Width="130"
                            Margin="5"
                            Style="{DynamicResource SuccessButton}"/>

                    <Button Content="💾 Сохранить"
                            Click="Update_Click"
                            Width="140"
                            Margin="5"
                            Style="{DynamicResource PrimaryButton}"/>

                    <Button Content="🗑️ Удалить"
                            Click="Delete_Click"
                            Width="130"
                            Margin="5"
                            Background="{DynamicResource DangerBrush}"
                            Foreground="White"/>

                    <Button Content="🔄 Очистить"
                            Click="Clear_Click"
                            Width="130"
                            Margin="5"
                            Background="{DynamicResource SecondaryBackgroundBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}"/>

                </WrapPanel>

            </Grid>

        </Border>

        <!-- TABLE -->

        <Border Grid.Row="2"
                Style="{DynamicResource SectionCard}">

            <DataGrid x:Name="dgUsers"
                      AutoGenerateColumns="True"
                      SelectionChanged="dgUsers_SelectionChanged"
                      SelectionMode="Single"
                      Background="Transparent"
                      BorderThickness="0"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="42"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      RowBackground="{DynamicResource CardBackgroundBrush}"
                      AlternatingRowBackground="{DynamicResource SecondaryBackgroundBrush}">

                <DataGrid.Resources>

                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                     Color="#4CAF50"/>

                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                     Color="White"/>

                </DataGrid.Resources>

            </DataGrid>

        </Border>

        <!-- STATUS -->

        <TextBlock x:Name="txtStatus"
                   Grid.Row="3"
                   Margin="0,10,0,0"
                   HorizontalAlignment="Right"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>

    </Grid>

</Page>