<Page x:Class="Energy.Pages.AdminPages.AdminSubscriptionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Управление абонементами"
      Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <TextBlock Text="📋 Управление абонементами" FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" 
                CornerRadius="12" Padding="20" Margin="0,0,0,20"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Строка 1 -->
                <TextBlock Text="Название:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="txtName" Grid.Column="1" Margin="0,0,20,0" 
                         Height="35" Padding="8,0" VerticalAlignment="Center"
                         Background="{DynamicResource CardBackgroundBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"/>

                <TextBlock Text="Условие:" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="txtCondition" Grid.Column="3" Margin="0" 
                         Height="35" Padding="8,0" VerticalAlignment="Center"
                         Background="{DynamicResource CardBackgroundBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"/>

                <!-- Строка 2 -->
                <TextBlock Text="Срок (дней):" Grid.Row="1" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="txtDurationDays" Grid.Row="1" Grid.Column="1" Margin="0,0,20,0" 
                         Height="35" Padding="8,0" VerticalAlignment="Center"
                         Background="{DynamicResource CardBackgroundBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"/>

                <TextBlock Text="Цена (BYN):" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="txtPrice" Grid.Row="1" Grid.Column="3" Margin="0" 
                         Height="35" Padding="8,0" VerticalAlignment="Center"
                         Background="{DynamicResource CardBackgroundBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"/>
            </Grid>
        </Border>

        <!-- Кнопки управления -->
        <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,20">
            <Button Content="➕ Добавить" Click="Add_Click" Width="110" Height="35" Margin="5" 
                    Background="#4CAF50" Foreground="White"  FontWeight="SemiBold"/>
            <Button Content="✏️ Обновить" Click="Update_Click" Width="110" Height="35" Margin="5" 
                    Background="#2196F3" Foreground="White"  FontWeight="SemiBold"/>
            <Button Content="🗑️ Удалить" Click="Delete_Click" Width="110" Height="35" Margin="5" 
                    Background="#F44336" Foreground="White"  FontWeight="SemiBold"/>
            <Button Content="🔄 Очистить" Click="Clear_Click" Width="110" Height="35" Margin="5" 
                    Background="#607D8B" Foreground="White"  FontWeight="SemiBold"/>
        </WrapPanel>

        <!-- Таблица -->
        <Border Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="1">
            <DataGrid x:Name="dgSubscriptions" 
                      AutoGenerateColumns="True" 
                      CanUserSortColumns="True"
                      SelectionChanged="dgSubscriptions_SelectionChanged"
                      SelectionMode="Single"
                      Background="Transparent"
                      RowHeight="40"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      RowBackground="{DynamicResource CardBackgroundBrush}"
              
                      Foreground="{DynamicResource TextPrimaryBrush}">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#4CAF50"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>
                </DataGrid.Resources>
            </DataGrid>
        </Border>

        <!-- Статус -->
        <TextBlock x:Name="txtStatus" Grid.Row="4" Margin="0,10" Foreground="{DynamicResource TextSecondaryBrush}" 
                   FontSize="11" HorizontalAlignment="Right"/>
    </Grid>
</Page>