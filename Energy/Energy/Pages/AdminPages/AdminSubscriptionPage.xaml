<Page x:Class="Energy.Pages.AdminPages.AdminSubscriptionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Управление абонементами"
      Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <TextBlock Text="Управление абонементами"
                   Style="{DynamicResource PageTitle}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,24"/>

        <!-- FORM -->
        <Border Grid.Row="1"
                Style="{DynamicResource SectionCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- NAME -->
                <TextBlock Text="Название:"
                           Style="{DynamicResource FormLabel}"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="txtName"
                         Grid.Column="1"
                         Margin="0,0,20,0"/>

                <!-- CONDITION -->
                <TextBlock Text="Условие:"
                           Grid.Column="2"
                           Style="{DynamicResource FormLabel}"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="txtCondition"
                         Grid.Column="3"/>

                <!-- DURATION -->
                <TextBlock Text="Срок (дней):"
                           Grid.Row="2"
                           Style="{DynamicResource FormLabel}"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="txtDurationDays"
                         Grid.Row="2"
                         Grid.Column="1"
                         Margin="0,0,20,0"/>

                <!-- PRICE -->
                <TextBlock Text="Цена (BYN):"
                           Grid.Row="2"
                           Grid.Column="2"
                           Style="{DynamicResource FormLabel}"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="txtPrice"
                         Grid.Row="2"
                         Grid.Column="3"/>
            </Grid>
        </Border>

        <!-- BUTTONS -->
        <WrapPanel Grid.Row="2"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20">
            <Button Content="➕ Добавить"
                    Click="Add_Click"
                    Width="140"
                    Margin="6"
                    Style="{DynamicResource SuccessButton}"/>
            <Button Content="✏️ Обновить"
                    Click="Update_Click"
                    Width="140"
                    Margin="6"
                    Style="{DynamicResource PrimaryButton}"/>
            <Button Content="🗑️ Удалить"
                    Click="Delete_Click"
                    Width="140"
                    Margin="6"
                    Style="{DynamicResource DangerButton}"/>
            <Button Content="🔄 Очистить"
                    Click="Clear_Click"
                    Width="140"
                    Margin="6"
                    Style="{DynamicResource SecondaryButton}"/>
        </WrapPanel>

        <!-- TABLE -->
        <Border Grid.Row="3"
                Style="{DynamicResource SectionCard}"
                Padding="0">
            <DataGrid x:Name="dgSubscriptions"
                      AutoGenerateColumns="True"
                      CanUserSortColumns="True"
                      SelectionChanged="dgSubscriptions_SelectionChanged"
                      SelectionMode="Single"
                      RowHeight="42"
                      BorderThickness="0"
                      Margin="1">
                <DataGrid.Resources>
                    <SolidColorBrush
                        x:Key="{x:Static SystemColors.HighlightBrushKey}"
                        Color="#4CAF50"/>
                    <SolidColorBrush
                        x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                        Color="#4CAF50"/>
                </DataGrid.Resources>
            </DataGrid>
        </Border>

        <!-- STATUS -->
        <TextBlock x:Name="txtStatus"
                   Grid.Row="4"
                   Margin="0,12,0,0"
                   HorizontalAlignment="Right"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</Page>