<Page x:Class="Energy.Pages.AdminPages.AdminGroupClassesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      Title="Управление групповыми занятиями"
      Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="🧘 Управление групповыми занятиями" FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Форма ввода -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" 
                CornerRadius="12" Padding="20" Margin="0,0,0,20"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Строка 1: Название + Тренер -->
                <TextBlock Text="Название:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="txtName" Grid.Column="1" Margin="0,0,20,0" 
                         Height="35" Padding="8,0" VerticalAlignment="Center"
                         Background="{DynamicResource CardBackgroundBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"/>

                <TextBlock Text="Тренер:" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ComboBox x:Name="cbTrainer" Grid.Column="3" Height="35" Margin="0"
                          DisplayMemberPath="FirstName"
                          SelectedValuePath="Id"
                          Background="{DynamicResource CardBackgroundBrush}"
                          BorderBrush="{DynamicResource BorderBrush}"/>

                <!-- Строка 2: Дата + Время -->
                <TextBlock Text="Дата:" Grid.Row="1" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <DatePicker x:Name="dpDate" Grid.Row="1" Grid.Column="1" 
                            Width="150" Height="35" Margin="0,0,20,0"
                            VerticalAlignment="Center"
                            SelectedDate="{x:Static sys:DateTime.Now}"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"/>

                <TextBlock Text="Время:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ComboBox x:Name="cbTime" Grid.Row="1" Grid.Column="3" 
                          Width="120" Height="35" Margin="0"
                          VerticalAlignment="Center"
                          IsEditable="True"
                          Background="{DynamicResource CardBackgroundBrush}"
                          BorderBrush="{DynamicResource BorderBrush}">
                    <ComboBoxItem Content="09:00"/>
                    <ComboBoxItem Content="10:00"/>
                    <ComboBoxItem Content="11:00"/>
                    <ComboBoxItem Content="12:00"/>
                    <ComboBoxItem Content="13:00"/>
                    <ComboBoxItem Content="14:00"/>
                    <ComboBoxItem Content="15:00"/>
                    <ComboBoxItem Content="16:00"/>
                    <ComboBoxItem Content="17:00"/>
                    <ComboBoxItem Content="18:00"/>
                    <ComboBoxItem Content="19:00"/>
                    <ComboBoxItem Content="20:00"/>
                </ComboBox>

                <!-- Строка 3: Длительность + Макс. мест -->
                <TextBlock Text="Длительность (мин):" Grid.Row="2" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="txtDuration" Grid.Row="2" Grid.Column="1" Margin="0,0,20,0" 
                         Height="35" Padding="8,0" VerticalAlignment="Center"
                         Background="{DynamicResource CardBackgroundBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         Text="60"/>

                <TextBlock Text="Макс. мест:" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="txtMaxParticipants" Grid.Row="2" Grid.Column="3" Margin="0" 
                         Height="35" Padding="8,0" VerticalAlignment="Center"
                         Background="{DynamicResource CardBackgroundBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         Text="10"/>

                <!-- Строка 4: Описание -->
                <TextBlock Text="Описание:" Grid.Row="3" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="txtDescription" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" 
                         Height="60" Padding="8,5" TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource CardBackgroundBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"/>
            </Grid>
        </Border>

        <!-- Кнопки управления -->
        <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,20">
            <Button Content="➕ Добавить" Click="Add_Click" Width="110" Height="35" Margin="5" 
                    Background="#4CAF50" Foreground="White" FontWeight="SemiBold"/>
            <Button Content="✏️ Обновить" Click="Update_Click" Width="110" Height="35" Margin="5" 
                    Background="#2196F3" Foreground="White" FontWeight="SemiBold"/>
            <Button Content="🗑️ Удалить" Click="Delete_Click" Width="110" Height="35" Margin="5" 
                    Background="#F44336" Foreground="White" FontWeight="SemiBold"/>
            <Button Content="🔄 Очистить" Click="Clear_Click" Width="110" Height="35" Margin="5" 
                    Background="#607D8B" Foreground="White" FontWeight="SemiBold"/>
        </WrapPanel>

        <!-- Таблица -->
        <Border Grid.Row="3" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="1">
            <DataGrid x:Name="dgClasses" 
                      AutoGenerateColumns="True" 
                      CanUserSortColumns="True"
                      SelectionChanged="dgClasses_SelectionChanged"
                      SelectionMode="Single"
                      Background="Transparent"
                      RowHeight="40"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      RowBackground="{DynamicResource CardBackgroundBrush}"
                     
                      Foreground="{DynamicResource TextPrimaryBrush}">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#4CAF50"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>
                </DataGrid.Resources>
            </DataGrid>
        </Border>

        <!-- Статус -->
        <TextBlock x:Name="txtStatus" Grid.Row="4" Margin="0,10" Foreground="{DynamicResource TextSecondaryBrush}" 
                   FontSize="11" HorizontalAlignment="Right"/>
    </Grid>
</Page>