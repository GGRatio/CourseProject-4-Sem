<Page x:Class="Energy.Pages.AdminPages.AdminGroupClassesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      Title="Управление групповыми занятиями"
      Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <TextBlock Text="Управление групповыми занятиями"
                   Style="{DynamicResource PageTitle}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- FORM -->
        <Border Grid.Row="1"
                Style="{DynamicResource SectionCard}">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- NAME -->
                <TextBlock Text="Название:"
                           Grid.Row="0"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="txtName"
                         Grid.Row="0"
                         Grid.Column="1"
                         Margin="0,0,20,0"/>

                <!-- TRAINER -->
                <TextBlock Text="Тренер:"
                           Grid.Row="0"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <ComboBox x:Name="cbTrainer"
                          Grid.Row="0"
                          Grid.Column="3"
                          DisplayMemberPath="FirstName"
                          SelectedValuePath="Id"/>

                <!-- DATE -->
                <TextBlock Text="Дата:"
                           Grid.Row="1"
                           Grid.Column="0"
                           Margin="0,15,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <DatePicker x:Name="dpDate"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,15,20,0"
                            SelectedDate="{x:Static sys:DateTime.Now}"/>

                <!-- TIME -->
                <TextBlock Text="Время:"
                           Grid.Row="1"
                           Grid.Column="2"
                           Margin="0,15,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <ComboBox x:Name="cbTime"
                          Grid.Row="1"
                          Grid.Column="3"
                          Margin="0,15,0,0"
                          IsEditable="True">

                    <ComboBoxItem Content="09:00"/>
                    <ComboBoxItem Content="10:00"/>
                    <ComboBoxItem Content="11:00"/>
                    <ComboBoxItem Content="12:00"/>
                    <ComboBoxItem Content="13:00"/>
                    <ComboBoxItem Content="14:00"/>
                    <ComboBoxItem Content="15:00"/>
                    <ComboBoxItem Content="16:00"/>
                    <ComboBoxItem Content="17:00"/>
                    <ComboBoxItem Content="18:00"/>
                    <ComboBoxItem Content="19:00"/>
                    <ComboBoxItem Content="20:00"/>
                </ComboBox>

                <!-- DURATION -->
                <TextBlock Text="Длительность:"
                           Grid.Row="2"
                           Grid.Column="0"
                           Margin="0,15,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="txtDuration"
                         Grid.Row="2"
                         Grid.Column="1"
                         Margin="0,15,20,0"
                         Text="60"/>

                <!-- MAX PARTICIPANTS -->
                <TextBlock Text="Макс. мест:"
                           Grid.Row="2"
                           Grid.Column="2"
                           Margin="0,15,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="txtMaxParticipants"
                         Grid.Row="2"
                         Grid.Column="3"
                         Margin="0,15,0,0"
                         Text="10"/>

                <!-- DESCRIPTION -->
                <TextBlock Text="Описание:"
                           Grid.Row="3"
                           Grid.Column="0"
                           Margin="0,15,0,0"
                           VerticalAlignment="Top"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="txtDescription"
                         Grid.Row="3"
                         Grid.Column="1"
                         Grid.ColumnSpan="3"
                         Margin="0,15,0,0"
                         Height="70"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"/>

            </Grid>
        </Border>

        <!-- BUTTONS -->
        <WrapPanel Grid.Row="2"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,0">

            <Button Content="➕ Добавить"
                    Click="Add_Click"
                    Width="130"
                    Margin="5"
                    Style="{DynamicResource SuccessButton}"/>

            <Button Content="💾 Обновить"
                    Click="Update_Click"
                    Width="140"
                    Margin="5"
                    Style="{DynamicResource PrimaryButton}"/>

            <Button Content="🗑️ Удалить"
                    Click="Delete_Click"
                    Width="130"
                    Margin="5"
                    Background="{DynamicResource DangerBrush}"
                    Foreground="White"/>

            <Button Content="🔄 Очистить"
                    Click="Clear_Click"
                    Width="130"
                    Margin="5"
                    Background="{DynamicResource SecondaryBackgroundBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"/>

        </WrapPanel>

        <!-- TABLE -->
        <Border Grid.Row="3"
                Style="{DynamicResource SectionCard}">

            <DataGrid x:Name="dgClasses"
                      AutoGenerateColumns="True"
                      SelectionChanged="dgClasses_SelectionChanged"
                      SelectionMode="Single"
                      Background="Transparent"
                      BorderThickness="0"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="42"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      RowBackground="{DynamicResource CardBackgroundBrush}"
                      AlternatingRowBackground="{DynamicResource SecondaryBackgroundBrush}">

                <DataGrid.Resources>

                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                     Color="#4CAF50"/>

                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                     Color="White"/>

                </DataGrid.Resources>

            </DataGrid>

        </Border>

        <!-- STATUS -->
        <TextBlock x:Name="txtStatus"
                   Grid.Row="3"
                   Margin="0,10,0,0"
                   HorizontalAlignment="Right"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>

    </Grid>
</Page>