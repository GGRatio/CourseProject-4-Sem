<Page x:Class="Energy.Pages.AdminPages.AdminTrainersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Управление тренерами"
      Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="👨‍🏫 Управление тренерами" FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Форма редактирования -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" 
                CornerRadius="12" Padding="20" Margin="0,0,0,20"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Имя -->
                <TextBlock Text="Имя:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="txtFirstName" Grid.Column="1" Margin="0,0,20,0" 
                         Height="35" Padding="8,0" VerticalAlignment="Center"
                         Background="{DynamicResource CardBackgroundBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"/>

                <!-- Фамилия -->
                <TextBlock Text="Фамилия:" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="txtLastName" Grid.Column="3" Margin="0" 
                         Height="35" Padding="8,0" VerticalAlignment="Center"
                         Background="{DynamicResource CardBackgroundBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"/>

                <!-- Специализация -->
                <TextBlock Text="Специализация:" Grid.Row="1" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="txtSpecialization" Grid.Row="1" Grid.Column="1" Margin="0,0,20,0" 
                         Height="35" Padding="8,0" VerticalAlignment="Center"
                         Background="{DynamicResource CardBackgroundBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"/>

                <!-- Опыт -->
                <TextBlock Text="Опыт (лет):" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="txtExperience" Grid.Row="1" Grid.Column="3" Margin="0" 
                         Height="35" Padding="8,0" VerticalAlignment="Center"
                         Background="{DynamicResource CardBackgroundBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"/>

                <!-- Фото -->
                <TextBlock Text="Фото:" Grid.Row="2" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal">
                    <TextBox x:Name="txtPhotoPath" Width="200" Height="35" Padding="8,0" VerticalAlignment="Center"
                             Background="{DynamicResource CardBackgroundBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             IsReadOnly="True"/>
                    <Button Content="📁 Выбрать" Click="SelectPhoto_Click" Width="80" Height="35" Margin="10,0,0,0"
                            Background="#2196F3" Foreground="White" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Описание -->
                <TextBlock Text="Описание:" Grid.Row="3" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="txtDescription" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" 
                         Height="60" Padding="8,5" TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource CardBackgroundBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"/>
            </Grid>
        </Border>

        <!-- Кнопки управления -->
        <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,20">
            <Button Content="➕ Добавить" Click="Add_Click" Width="110" Height="35" Margin="5" 
                    Background="#4CAF50" Foreground="White" FontWeight="SemiBold"/>
            <Button Content="✏️ Обновить" Click="Update_Click" Width="110" Height="35" Margin="5" 
                    Background="#2196F3" Foreground="White" FontWeight="SemiBold"/>
            <Button Content="🗑️ Удалить" Click="Delete_Click" Width="110" Height="35" Margin="5" 
                    Background="#F44336" Foreground="White" FontWeight="SemiBold"/>
            <Button Content="🔄 Очистить" Click="Clear_Click" Width="110" Height="35" Margin="5" 
                    Background="#607D8B" Foreground="White" FontWeight="SemiBold"/>
        </WrapPanel>

        <!-- Таблица тренеров -->
        <Border Grid.Row="3" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="1">
            <DataGrid x:Name="dgTrainers" 
                      AutoGenerateColumns="True" 
                      CanUserSortColumns="True"
                      SelectionChanged="dgTrainers_SelectionChanged"
                      SelectionMode="Single"
                      Background="Transparent"
                      RowHeight="40"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      RowBackground="{DynamicResource CardBackgroundBrush}"
                      
                      Foreground="{DynamicResource TextPrimaryBrush}">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#4CAF50"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>
                </DataGrid.Resources>
            </DataGrid>
        </Border>

        <!-- Статус -->
        <TextBlock x:Name="txtStatus" Grid.Row="4" Margin="0,10" Foreground="{DynamicResource TextSecondaryBrush}" 
                   FontSize="11" HorizontalAlignment="Right"/>
    </Grid>
</Page>