<Page x:Class="Energy.Pages.AdminPages.AdminTrainersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Управление тренерами"
      Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <TextBlock Text="Управление тренерами"
                   Style="{DynamicResource PageTitle}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,24"/>

        <!-- FORM -->
        <Border Grid.Row="1"
                Style="{DynamicResource SectionCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- FIRST NAME -->
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Имя:"
                           Style="{DynamicResource FormLabel}"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="txtFirstName"
                         Grid.Row="0"
                         Grid.Column="1"
                         Margin="0,0,20,0"/>

                <!-- LAST NAME -->
                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           Text="Фамилия:"
                           Style="{DynamicResource FormLabel}"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="txtLastName"
                         Grid.Row="0"
                         Grid.Column="3"/>

                <!-- SPECIALIZATION -->
                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Специализация:"
                           Style="{DynamicResource FormLabel}"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="txtSpecialization"
                         Grid.Row="2"
                         Grid.Column="1"
                         Margin="0,0,20,0"/>

                <!-- EXPERIENCE -->
                <TextBlock Grid.Row="2"
                           Grid.Column="2"
                           Text="Опыт (лет):"
                           Style="{DynamicResource FormLabel}"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="txtExperience"
                         Grid.Row="2"
                         Grid.Column="3"/>

                <!-- PHOTO -->
                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Text="Фото:"
                           Style="{DynamicResource FormLabel}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Row="4"
                            Grid.Column="1"
                            Grid.ColumnSpan="3"
                            Orientation="Horizontal">
                    <TextBox x:Name="txtPhotoPath"
                             Width="260"
                             IsReadOnly="True"/>
                    <Button Content="Выбрать"
                            Click="SelectPhoto_Click"
                            Style="{DynamicResource PrimaryButton}"
                            Width="130"
                            Margin="12,0,0,0"/>
                </StackPanel>

                <!-- DESCRIPTION -->
                <TextBlock Grid.Row="6"
                           Grid.Column="0"
                           Text="Описание:"
                           Style="{DynamicResource FormLabel}"
                           VerticalAlignment="Top"
                           Margin="0,10,0,0"/>
                <TextBox x:Name="txtDescription"
                         Grid.Row="6"
                         Grid.Column="1"
                         Grid.ColumnSpan="3"
                         Height="100"
                         Padding="12"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>

        <!-- ACTION BUTTONS -->
        <WrapPanel Grid.Row="2"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20">
            <Button Content="✏️ Обновить"
                    Click="Update_Click"
                    Width="140"
                    Margin="6"
                    Style="{DynamicResource PrimaryButton}"/>
            <Button Content="🗑️ Удалить"
                    Click="Delete_Click"
                    Width="140"
                    Margin="6"
                    Style="{DynamicResource DangerButton}"/>
            <Button Content="🔄 Очистить"
                    Click="Clear_Click"
                    Width="140"
                    Margin="6"
                    Style="{DynamicResource SecondaryButton}"/>
        </WrapPanel>

        <!-- DATAGRID -->
        <Border Grid.Row="3"
                Style="{DynamicResource SectionCard}"
                Padding="0">
            <DataGrid x:Name="dgTrainers"
                      AutoGenerateColumns="True"
                      CanUserSortColumns="True"
                      SelectionChanged="dgTrainers_SelectionChanged"
                      SelectionMode="Single"
                      RowHeight="42"
                      Margin="1"
                      BorderThickness="0">
                <DataGrid.Resources>
                    <SolidColorBrush
                        x:Key="{x:Static SystemColors.HighlightBrushKey}"
                        Color="#4CAF50"/>
                    <SolidColorBrush
                        x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                        Color="#4CAF50"/>
                </DataGrid.Resources>
            </DataGrid>
        </Border>

        <!-- STATUS -->
        <TextBlock x:Name="txtStatus"
                   Grid.Row="4"
                   Margin="0,12,0,0"
                   HorizontalAlignment="Right"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>

    </Grid>
</Page>