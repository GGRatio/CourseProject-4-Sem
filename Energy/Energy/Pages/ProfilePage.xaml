<Page x:Class="Energy.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Energy.Pages"
      mc:Ignorable="d" 
      Height="Auto" Width="Auto"
      Title="ProfilePage">

    <Grid Background="#F5F5F5">
        <Grid Margin="50">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Профиль пользователя" FontSize="28" FontWeight="Bold" 
                   Grid.ColumnSpan="2" Margin="0,0,0,30"/>

            <!-- Логин (только для чтения) -->
            <TextBlock Text="Логин:" FontSize="16" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0"/>
            <TextBlock x:Name="txtLogin" FontSize="16" VerticalAlignment="Center" Grid.Row="1" Grid.Column="1" Margin="10,0,0,0"/>

            <!-- Имя -->
            <TextBlock Text="Имя:" FontSize="16" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" Margin="0,10"/>
            <TextBox x:Name="txtFirstName" FontSize="16" Grid.Row="2" Grid.Column="1" Margin="10,10,0,10"/>

            <!-- Фамилия -->
            <TextBlock Text="Фамилия:" FontSize="16" VerticalAlignment="Center" Grid.Row="3" Grid.Column="0" Margin="0,10"/>
            <TextBox x:Name="txtLastName" FontSize="16" Grid.Row="3" Grid.Column="1" Margin="10,10,0,10"/>

            <!-- Телефон -->
            <TextBlock Text="Телефон:" FontSize="16" VerticalAlignment="Center" Grid.Row="4" Grid.Column="0" Margin="0,10"/>
            <TextBox x:Name="txtPhone" FontSize="16" Grid.Row="4" Grid.Column="1" Margin="10,10,0,10"/>

            <!-- Email -->
            <TextBlock Text="Email:" FontSize="16" VerticalAlignment="Center" Grid.Row="5" Grid.Column="0" Margin="0,10"/>
            <TextBox x:Name="txtEmail" FontSize="16" Grid.Row="5" Grid.Column="1" Margin="10,10,0,10"/>

            <!-- Кнопки -->
            <StackPanel Orientation="Horizontal" Grid.Row="6" Grid.ColumnSpan="2" Margin="0,30,0,0">
                <Button x:Name="btnSave" Content="Сохранить" Width="120" Height="35" 
                    Background="#4CAF50" Foreground="White" FontSize="14"
                    Margin="0,0,10,0" Click="btnSave_Click"/>
                <Button x:Name="btnEdit" Content="Редактировать" Width="120" Height="35" 
                    Background="#2196F3" Foreground="White" FontSize="14"
                    Click="btnEdit_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
