<Page x:Class="Energy.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Профиль"
      MinHeight="800">

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Кнопки смены тем -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="Светлая" Click="LightTheme_Click" Width="100" Margin="5"
                    Background="{DynamicResource ButtonPrimaryBrush}" Foreground="White"/>
            <Button Content="Тёмная" Click="DarkTheme_Click" Width="100" Margin="5"
                    Background="{DynamicResource ButtonPrimaryBrush}" Foreground="White"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Center" Width="550" Margin="0,0,0,30">

                <!-- Карточка профиля -->
                <Border Background="{DynamicResource CardBackgroundBrush}" 
                        CornerRadius="15" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1"
                        Padding="25">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Логин:" Grid.Row="0" Grid.Column="0" 
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="txtLogin" FontWeight="SemiBold" 
                                   Grid.Row="0" Grid.Column="1" Margin="10,0,0,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <TextBlock Text="Имя:" Grid.Row="1" Grid.Column="0" Margin="0,15,0,0" 
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBox x:Name="txtFirstName" Grid.Row="1" Grid.Column="1"
                                 Background="{DynamicResource CardBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>

                        <TextBlock Text="Фамилия:" Grid.Row="2" Grid.Column="0" Margin="0,15,0,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBox x:Name="txtLastName" Grid.Row="2" Grid.Column="1"
                                 Background="{DynamicResource CardBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>

                        <TextBlock Text="Телефон:" Grid.Row="3" Grid.Column="0" Margin="0,15,0,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBox x:Name="txtPhone" Grid.Row="3" Grid.Column="1"
                                 Background="{DynamicResource CardBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>

                        <TextBlock Text="Email:" Grid.Row="4" Grid.Column="0" Margin="0,15,0,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBox x:Name="txtEmail" Grid.Row="4" Grid.Column="1"
                                 Background="{DynamicResource CardBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>

                        <!-- Кнопки -->
                        <StackPanel Orientation="Horizontal" Grid.Row="5" Grid.ColumnSpan="2" 
                                    HorizontalAlignment="Center" Margin="0,25,0,0">
                            <Button x:Name="btnSave" Content="Сохранить" 
                                    Width="120" Height="35"
                                    Background="{DynamicResource ButtonSuccessBrush}" 
                                    Foreground="White"
                                    Click="btnSave_Click" 
                                    Margin="0,0,10,0"/>
                            <Button x:Name="btnEdit" Content="Редактировать" 
                                    Width="120" Height="35"
                                    Background="{DynamicResource ButtonPrimaryBrush}" 
                                    Foreground="White"
                                    Click="btnEdit_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Блок текущего абонемента -->
                <Border Background="{DynamicResource CardBackgroundBrush}" 
                        CornerRadius="15" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1"
                        Padding="25" Margin="0,25,0,0">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Мой абонемент" FontSize="20" FontWeight="Bold" 
                                   Margin="0,0,0,15"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <TextBlock x:Name="txtSubscriptionName" FontSize="16" FontWeight="SemiBold"
                                   Grid.Row="1" Foreground="{DynamicResource ButtonSuccessBrush}"/>

                        <TextBlock x:Name="txtSubscriptionEndDate" FontSize="14"
                                   Grid.Row="2" Margin="0,5,0,0" 
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <TextBlock x:Name="txtSubscriptionStatus" FontSize="14"
                                   Grid.Row="3" Margin="0,5,0,0" 
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>
                </Border>


                <!-- История абонементов -->
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="15" 
        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
        Padding="25" Margin="0,25,0,0">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="История абонементов" FontSize="20" FontWeight="Bold" 
                   Margin="0,0,0,15"/>

                        <ListBox x:Name="lstPurchaseHistory" Grid.Row="1" 
                 Background="Transparent" BorderThickness="0"
                 MaxHeight="200">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BorderBrush}" 
                            CornerRadius="8" Margin="0,0,0,8" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SubscriptionName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding PurchaseDate, StringFormat='Куплен: dd.MM.yyyy'}" 
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding EndDate, StringFormat='Действовал до: dd.MM.yyyy'}" 
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Status}" FontSize="11" 
                                       Foreground="{Binding StatusColor}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>


                <!-- Текущий тренер -->
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="15" 
        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
        Padding="25" Margin="0,25,0,0">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Мой тренер" FontSize="20" FontWeight="Bold" 
                   Margin="0,0,0,15"/>

                        <!-- Фото + информация о тренере -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,0">

                            <!-- Маленькое фото тренера -->
                            <Border x:Name="TrainerPhotoBorder" 
                    Width="60" Height="60" 
                    CornerRadius="10"
                    Background="{DynamicResource BorderBrush}"
                    Margin="0,0,15,0"
                    VerticalAlignment="Center">
                                <Image x:Name="TrainerPhoto" 
                       Stretch="UniformToFill"
                       VerticalAlignment="Center"/>
                            </Border>

                            <!-- Информация -->
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="txtMyTrainer" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="txtTrainerSpecialization" FontSize="12" 
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                           <!-- <Button x:Name="btnDetails" Margin="20" Content="Подробнее" 
                                Width="120" Height="35"
                                Background="{DynamicResource ButtonPrimaryBrush}" 
                                Foreground="White"
                                Click="btnDetail_Click"/> -->
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Мои записи на занятия -->
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="15" 
        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
        Padding="25" Margin="0,25,0,0">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Мои записи" FontSize="20" FontWeight="Bold" 
                   Margin="0,0,0,15"/>

                        <!-- Сообщение когда нет записей -->
                        <TextBlock x:Name="txtNoClasses" Grid.Row="1" 
                   Text="📭 У вас нет активных записей"
                   FontSize="13"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   HorizontalAlignment="Center"
                   Margin="10"
                   Visibility="Collapsed"/>

                        <!-- Список записей -->
                        <ListBox x:Name="lstMyClasses" Grid.Row="1" 
                 Background="Transparent" BorderThickness="0"
                 MaxHeight="200"
                 Visibility="Visible">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackgroundBrush}" 
                            CornerRadius="8"
                            BorderBrush="{DynamicResource BorderBrush}" 
                            BorderThickness="1" Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" 
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Instructor}" FontSize="12" 
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding ClassDateText}" FontSize="11" 
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>

                                            <Button Grid.Column="1" Content="❌ Отменить" 
                                    Click="CancelClass_Click" Tag="{Binding Id}"
                                    Background="#F44336" Foreground="White"
                                    Padding="10,5" Margin="10,0,0,0"
                                    Cursor="Hand" FontSize="12"
                                    VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>


                <!-- Блок посещений -->
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="15" 
        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
        Padding="25" Margin="0,25,0,0">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Мои посещения" FontSize="20" FontWeight="Bold" 
                   Margin="0,0,0,15"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Всего посещений:" FontSize="16" 
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="txtVisitsCount" Grid.Column="1" FontSize="16" 
                       FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="15,0,0,0" HorizontalAlignment="Left"/>
                        </Grid>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>